# ChartBridge AI — environment. EVERYTHING is optional: with zero keys the app
# runs fully on the live FHIR sandbox with a deterministic report + lexical RAG.
# Add keys to light up Grok generation and a real vector DB.

# --- xAI Grok (report generation; voice handled separately) ---
# Without this, reports use the deterministic reconciliation engine.
XAI_API_KEY=
# Optional override; defaults to grok-4.3 (June 2026 flagship).
# GROK_MODEL=grok-4.3

# --- Embeddings for the vector DB (xAI has no public embeddings endpoint) ---
# Enables OpenAI in-memory cosine RAG, and is required for the turbopuffer path.
OPENAI_API_KEY=

# --- turbopuffer (real vector DB over the clinic-CRM corpus) ---
# Needs OPENAI_API_KEY too. Without both, RAG falls back to in-memory/lexical.
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-us-central1

# --- FHIR (defaults to the zero-auth SMART Health IT launcher) ---
# FHIR_BASE_URL=https://launch.smarthealthit.org/v/r4/fhir
# DEFAULT_PATIENT_ID=5fbee500-9b99-4dad-bce4-0a4de9f9f3b9   # "Marsha Hayes"

# --- Inngest (autonomous pipeline; optional) ---
# Local: run `npx inngest-cli@latest dev` and set INNGEST_DEV=1.
# Vercel: install the Inngest integration (auto-sets the keys below).
# INNGEST_DEV=1
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=
